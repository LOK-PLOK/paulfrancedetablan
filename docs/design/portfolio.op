                        {
                          "type": "text",
                          "id": "n115",
                          "width": "fill_container",
                          "height": "fit_content",
                          "content": "I'm someone who genuinely enjoys building things, solving problems, and figuring out how technology works. Whether I'm developing an application, experimenting with a new tool, or learning something completely unfamiliar, I'm always looking for ways to improve.",
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 16.0,
                          "fontWeight": 400,
                          "lineHeight": 1.65,
                          "textGrowth": "fixed-width",
